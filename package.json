{
  "name": "mdmbox-docs",
  "private": true,
  "scripts": {
    "postinstall": "install-hooks",
    "lint": "bun run assets:check && docs-lint",
    "lint:check": "bun run assets:check && docs-lint --check",
    "lint:json": "bun run assets:check && docs-lint --json",
    "assets:version": "bun scripts/version-file-assets.ts",
    "assets:check": "bun scripts/version-file-assets.ts --check",
    "test": "bun test",
    "images:check": "docs-images check",
    "images:optimize": "docs-images optimize",
    "images:dry-run": "docs-images optimize --dry-run"
  },
  "devDependencies": {
    "docs-tools": "github:HealthSamurai/docs-tools"
  }
}
